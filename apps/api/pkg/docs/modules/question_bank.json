{
  "paths": {
    "/api/v1/question-banks": {
      "get": {
        "tags": ["Question Banks"],
        "summary": "Get All Questions",
        "description": "Get paginated list of questions from question bank",
        "security": [{ "CookieAuth": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 10 }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated question list",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Response" },
                    {
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "items": {
                              "type": "array",
                              "items": { "$ref": "#/components/schemas/QuestionBankResponse" }
                            },
                            "meta": { "$ref": "#/components/schemas/PaginationMeta" }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Response" }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Response" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Question Banks"],
        "summary": "Create Question",
        "description": "Create a new question in question bank. Admin only.",
        "security": [{ "CookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateQuestionBankRequest" },
              "examples": {
                "hr_question": {
                  "summary": "HR Question",
                  "value": {
                    "type": "HR",
                    "category": "Leadership",
                    "difficulty": "medium",
                    "question_text_id": "Ceritakan pengalaman kamu memimpin tim?",
                    "question_text_en": "Tell me about your experience leading a team?",
                    "tags": ["leadership", "teamwork"]
                  }
                },
                "technical_question": {
                  "summary": "Technical Question",
                  "value": {
                    "type": "USER",
                    "category": "System Design",
                    "difficulty": "hard",
                    "question_text_id": "Bagaimana kamu merancang sistem yang scalable?",
                    "question_text_en": "How would you design a scalable system?",
                    "tags": ["system-design", "architecture"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Question created",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Response" },
                    {
                      "properties": {
                        "data": { "$ref": "#/components/schemas/QuestionBankResponse" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Response" }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Response" }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Response" }
              }
            }
          }
        }
      }
    },
    "/api/v1/question-banks/{id}": {
      "get": {
        "tags": ["Question Banks"],
        "summary": "Get Question Detail",
        "security": [{ "CookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Question detail",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Response" },
                    {
                      "properties": {
                        "data": { "$ref": "#/components/schemas/QuestionBankResponse" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Response" }
              }
            }
          },
          "404": {
            "description": "Question not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Response" }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Response" }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["Question Banks"],
        "summary": "Update Question",
        "description": "Partial update question. Admin only.",
        "security": [{ "CookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateQuestionBankRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Question updated",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Response" },
                    {
                      "properties": {
                        "data": { "$ref": "#/components/schemas/QuestionBankResponse" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Response" }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Response" }
              }
            }
          },
          "404": {
            "description": "Question not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Response" }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Response" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Question Banks"],
        "summary": "Delete Question",
        "description": "Soft delete question by id. Admin only.",
        "security": [{ "CookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Question deleted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Response" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Response" }
              }
            }
          },
          "404": {
            "description": "Question not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Response" }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Response" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateQuestionBankRequest": {
        "type": "object",
        "required": ["type", "question_text_id", "question_text_en"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["HR", "USER"],
            "example": "HR"
          },
          "category": {
            "type": "string",
            "example": "Leadership"
          },
          "difficulty": {
            "type": "string",
            "enum": ["easy", "medium", "hard"],
            "example": "medium"
          },
          "question_text_id": {
            "type": "string",
            "example": "Ceritakan pengalaman kamu memimpin tim?"
          },
          "question_text_en": {
            "type": "string",
            "example": "Tell me about your experience leading a team?"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["leadership", "teamwork"]
          }
        }
      },
      "UpdateQuestionBankRequest": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "example": "Leadership"
          },
          "difficulty": {
            "type": "string",
            "enum": ["easy", "medium", "hard"],
            "example": "medium"
          },
          "question_text_id": {
            "type": "string",
            "example": "Ceritakan pengalaman kamu memimpin tim?"
          },
          "question_text_en": {
            "type": "string",
            "example": "Tell me about your experience leading a team?"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["leadership", "teamwork"]
          }
        }
      },
      "QuestionBankResponse": {
        "type": "object",
        "properties": {
          "id":                   { "type": "string", "format": "uuid" },
          "type":                 { "type": "string", "enum": ["HR", "USER"], "example": "HR" },
          "source":               { "type": "string", "enum": ["BANK", "GENERATED"], "example": "BANK" },
          "category":             { "type": "string", "example": "Leadership" },
          "difficulty":           { "type": "string", "enum": ["easy", "medium", "hard"], "example": "medium" },
          "question_text_id":     { "type": "string", "example": "Ceritakan pengalaman kamu memimpin tim?" },
          "question_text_en":     { "type": "string", "example": "Tell me about your experience leading a team?" },
          "tags":                 { "type": "array", "items": { "type": "string" }, "example": ["leadership", "teamwork"] },
          "is_opening_question":  { "type": "boolean", "example": false },
          "relevance_score":      { "type": "number", "example": 0.92 },
          "generation_reasoning": { "type": "string", "example": "Generated based on job description requiring leadership skills" },
          "created_at":           { "type": "string", "format": "date-time" },
          "updated_at":           { "type": "string", "format": "date-time" }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error":   { "type": "string", "example": "Invalid request" },
          "data": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "example": {
              "Type": "Type must be one of: HR USER",
              "QuestionTextId": "QuestionTextId is required"
            }
          }
        }
      }
    }
  }
}